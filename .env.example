# API Configuration for Personal Multi-Agent Assistant
# At least one provider API key is required.

# Google Gemini (Default recommended)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Default Model Selection:
DEFAULT_MODEL=gemini/gemini-3.5-flash

# Telegram Bot Integration (Optional for 24/7 Mobile Chat)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Self-Correction Maximum Retry Limit
MAX_EVAL_RETRIES=3

# Safe Execution Sandbox Directory
SANDBOX_DIR=./sandbox

# =============================================================
# Dedicated Smart Sales Assistant ("Be Smart With AI")
# Zero collision with main project's API key
# =============================================================
# Dedicated Gemini Key (1500 free requests/day quota optimization)
SALES_CLOSER_GEMINI_KEY=your_dedicated_sales_key_here
SALES_MODEL_NAME=gemini-3.5-flash

# WhatsApp Smart Message Buffer / Debouncer (5 - 10 seconds)
MESSAGE_BUFFER_SECONDS=7

# Jubayer Ahamed Sir's Telegram Chat ID for Hot-Lead Alerts
OWNER_TELEGRAM_CHAT_ID=6302370142

# Optional Google Sheet CRM Integration
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service_account.json

# Official Facebook Page API ("Be Smart With AI" Page from Ahmad Agent)
FB_PAGE_ID=1347013991822233
FB_PAGE_ACCESS_TOKEN=your_fb_page_access_token_here
FB_APP_ID=your_fb_app_id_here
FB_APP_SECRET=your_fb_app_secret_here

